rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin()        { return isSignedIn() && getUserRole() == 'ADMIN'; }
    function isDoctor()       { return isSignedIn() && getUserRole() == 'DOCTOR'; }
    function isReceptionist() { return isSignedIn() && getUserRole() == 'RECEPTIONIST'; }
    function isClinical()     { return isAdmin() || isDoctor(); }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || request.auth.uid == userId;
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;

      match /visits/{visitId} {
        allow read, write: if isClinical();

        match /diagnoses/{id} {
          allow read, write: if isClinical();
        }
        match /vitals/{id} {
          allow read, write: if isClinical();
        }
        match /complaints/{id} {
          allow read, write: if isClinical();
        }
        match /prescriptionItems/{id} {
          allow read, write: if isClinical();
        }
        match /documents/{id} {
          allow read, write: if isSignedIn();
        }
      }

      match /clinicalHistory/{id} {
        allow read, write: if isClinical();
      }
      match /familyHistory/{id} {
        allow read, write: if isClinical();
      }
      match /symptomNotes/{id} {
        allow read, write: if isClinical();
      }
      match /documents/{id} {
        allow read, write: if isSignedIn();
      }
      match /meta/{id} {
        allow read, write: if isClinical();
      }
    }

    match /appointments/{id} {
      allow read, write: if isSignedIn();
      allow delete: if false;
    }

    match /medicines/{id} {
      allow read: if isSignedIn();
      allow create, update: if isClinical();
      allow delete: if false;
    }

    match /invoices/{id} {
      allow read, write: if isSignedIn();
      allow delete: if false;

      match /payments/{id} {
        allow read, write: if isSignedIn();
      }
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /clinicSettings/{key} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sequences/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
