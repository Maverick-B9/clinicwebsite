rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidFileType() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf';
    }

    function isUnderSizeLimit() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    match /patients/{patientId}/photo.{ext} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidFileType() && isUnderSizeLimit();
      allow delete: if isSignedIn();
    }

    match /patients/{patientId}/visits/{visitId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isUnderSizeLimit();
      allow delete: if isSignedIn();
    }

    match /patients/{patientId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isUnderSizeLimit();
      allow delete: if isSignedIn();
    }
  }
}
